* text=auto

# Unity 的 YAML 资源（开启后 diff 可读，但会按行合并）
*.unity      text
*.prefab     text
*.asset      text
*.meta       text
*.mat        text
*.anim       text
*.controller text

# 二进制资源
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.ttf  binary
*.otf  binary
*.ttc  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.dll  binary
*.exe  binary

# Windows 批处理必须保持 CRLF，否则 cmd 解析 goto / 括号块会出错
*.bat text eol=crlf
*.cmd text eol=crlf
